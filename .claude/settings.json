{
  "permissions": {
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push --force-with-lease:*)",
      "Read(**/.env*)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p8)",
      "Read(**/*.p12)",
      "Read(**/*.mobileprovision)",
      "Read(**/*.cer)",
      "Read(**/*.jks)",
      "Read(**/*.keystore)",
      "Read(**/key.properties)",
      "Read(**/GoogleService-Info.plist)",
      "Read(**/google-services.json)",
      "Read(**/AuthKey_*.p8)",
      "Read(**/secrets/**)",
      "Read(**/.ssh/**)",
      "Edit(**/.env*)",
      "Edit(**/*.mobileprovision)",
      "Edit(**/*.jks)",
      "Edit(**/*.keystore)",
      "Edit(**/key.properties)",
      "Edit(**/secrets/**)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git ls-files:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(xcodebuild:*)",
      "Bash(xcrun simctl:*)",
      "Bash(swift build:*)",
      "Bash(swift test:*)",
      "Bash(flutter analyze:*)",
      "Bash(flutter test:*)",
      "Bash(flutter pub get:*)",
      "Bash(flutter build:*)",
      "Bash(dart format:*)",
      "Bash(dart analyze:*)",
      "Bash(./gradlew lint:*)",
      "Bash(./gradlew test:*)",
      "Bash(./gradlew assembleDebug:*)",
      "Bash(go build:*)",
    "Bash(go test:*)",
    "Bash(go version:*)",
    "Bash(ls:*)"
    ]
  }
}
